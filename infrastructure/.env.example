# --- обязательно поменять в production ---
SECRET_KEY=replace-with-64-random-chars
POSTGRES_PASSWORD=mangaflow
ENVIRONMENT=production

# Публичный адрес API (для ссылок на картинки). Пусто = берётся из запроса.
PUBLIC_BASE_URL=
HTTP_PORT=8080
LOG_LEVEL=INFO

# Большинство источников блокируют не-RU IP. Укажите прокси с российским выходом, если сервер за рубежом:
# SOURCES_PROXY=socks5://user:pass@ru-proxy:1080

# Отключить источники (JSON-массив):
# SOURCES_DISABLED=["mintmanga"]

# Зеркала и собственные токены оператора (опционально):
# SOURCE_READMANGA_BASE_URL=https://web.usagi.one
# SOURCE_MANGALIB_TOKEN=
# SOURCE_REMANGA_TOKEN=
# SOURCE_SENKURO_TOKEN=
# SOURCE_MANGALIB_EXTRA_IMAGE_SERVER=compress

UPDATE_CHECK_INTERVAL_MINUTES=360

# Docker image of the backend (published by GitHub Actions on every push to main).
# Pin a specific build to roll back, e.g. ghcr.io/kotbctakahe/mangaflow-backend:sha-29cf46f
# MANGAFLOW_IMAGE=ghcr.io/kotbctakahe/mangaflow-backend:latest
